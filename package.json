{
  "name": "fortified-thanksgiving",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "test:browser": "node qa/browser.mjs",
    "admin:recover": "node --env-file-if-exists=.env scripts/admin-recover.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.18.2",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
