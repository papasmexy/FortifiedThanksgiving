# Local development: npm run dev (loopback only). No default admin credentials.
PORT=3000
DATA_DIR=./data
BASE_URL=http://localhost:3000
# Production:
# NODE_ENV=production
# BASE_URL=https://your-real-service-hostname
# SESSION_SECRET=independent-random-value-at-least-32-characters
# ADMIN_ENCRYPTION_KEY=independent-stable-random-value-at-least-32-characters
# ADMIN_SETUP_TOKEN=single-use-bootstrap-random-value-at-least-32-characters
# Remove ADMIN_SETUP_TOKEN after enrolling the first admin.
# Keep ADMIN_ENCRYPTION_KEY in secure backup; never rotate it during normal operation.
