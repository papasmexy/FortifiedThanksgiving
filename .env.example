# npm run dev enables local demo accounts. Demo mode is forbidden in production.
PORT=3000
DATA_DIR=./data
# Production: use a long random value, stored securely, and a public HTTPS URL.
# NODE_ENV=production
# SESSION_SECRET=
# BASE_URL=https://thanksgiving.example.com
# OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
# OIDC_CLIENT_ID=
# OIDC_PRIVATE_KEY_PATH=/secure/path/entra-private-key.pem
# OIDC_CERT_THUMBPRINT=base64url-SHA256-of-the-public-certificate-DER
# IDENTITY_SECRET=
# Register BASE_URL/auth/callback as a web redirect URI in your SSO provider.
